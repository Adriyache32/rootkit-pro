# === FULL BACKUP ===
full_backup() {
    local backup_path="$BACKUP_DIR/${brand}_${model}_$(date +%Y%m%d_%H%M%S)"
    mkdir -p "$backup_path"/{apps,contacts,photos,files,sms,settings,system}

    header
    echo -e "  ${BLUE}${BOLD}FULL BACKUP${RESET}  ${DIM}${brand} ${model}${RESET}"
    box_line
    echo -e "  ${DIM}Destination: ${FG}${backup_path}${RESET}"
    echo ""

    echo -e "  ${BORDER}[1/7]${RESET} Backing up apps..."
    local app_list=$(adb shell pm list packages -3 2>/dev/null)
    local app_count=$(echo "$app_list" | wc -l)
    echo "$app_list" > "$backup_path/apps/package_list.txt"
    mkdir -p "$backup_path/apps/apks"
    local count=0
    echo "$app_list" | while read -r line; do
        local pkg=$(echo "$line" | sed 's/package://')
        local apk_path=$(adb shell pm path "$pkg" 2>/dev/null | head -1 | sed 's/package://')
        if [ -n "$apk_path" ]; then
            adb pull "$apk_path" "$backup_path/apps/apks/" 2>/dev/null
            count=$((count + 1))
            printf "\r  ${DIM}[%d/%d]${RESET} Backing up apps..." "$count" "$app_count"
        fi
    done
    echo -e "\n  ${GREEN}  ${app_count} apps backed up${RESET}"

    echo -e "  ${BORDER}[2/7]${RESET} Backing up contacts..."
    adb shell content query --uri content://contacts/phones/ 2>/dev/null > "$backup_path/contacts/contacts.txt" || \
        adb pull /data/data/com.android.providers.contacts/ "$backup_path/contacts/db/" 2>/dev/null
    echo -e "  ${GREEN}  Done${RESET}"

    echo -e "  ${BORDER}[3/7]${RESET} Backing up photos..."
    adb pull /sdcard/DCIM/ "$backup_path/photos/DCIM/" 2>/dev/null
    adb pull /sdcard/Pictures/ "$backup_path/photos/Pictures/" 2>/dev/null
    echo -e "  ${GREEN}  Done${RESET}"

    echo -e "  ${BORDER}[4/7]${RESET} Backing up downloads..."
    adb pull /sdcard/Download/ "$backup_path/files/Downloads/" 2>/dev/null
    echo -e "  ${GREEN}  Done${RESET}"

    echo -e "  ${BORDER}[5/7]${RESET} Backing up SMS..."
    adb shell content query --uri content://sms/ 2>/dev/null > "$backup_path/sms/sms_backup.txt"
    echo -e "  ${GREEN}  Done${RESET}"

    echo -e "  ${BORDER}[6/7]${RESET} Backing up settings..."
    adb shell settings list system > "$backup_path/settings/system.txt" 2>/dev/null
    adb shell settings list secure > "$backup_path/settings/secure.txt" 2>/dev/null
    adb shell settings list global > "$backup_path/settings/global.txt" 2>/dev/null
    adb shell getprop > "$backup_path/system/properties.txt" 2>/dev/null
    echo -e "  ${GREEN}  Done${RESET}"

    echo -e "  ${BORDER}[7/7]${RESET} Backing up internal storage..."
    adb pull /sdcard/Documents/ "$backup_path/files/Documents/" 2>/dev/null
    adb pull /sdcard/Music/ "$backup_path/files/Music/" 2>/dev/null
    adb pull /sdcard/Movies/ "$backup_path/files/Movies/" 2>/dev/null
    echo -e "  ${GREEN}  Done${RESET}"

    local size=$(du -sh "$backup_path" 2>/dev/null | awk '{print $1}')

    echo ""
    box_line
    echo -e "  ${GREEN}${BOLD}BACKUP COMPLETED${RESET}"
    echo -e "  ${DIM}Location:${RESET} ${FG}${backup_path}${RESET}"
    echo -e "  ${DIM}Size:${RESET}     ${FG}${size}${RESET}"
    echo -e "  ${DIM}Apps:${RESET}     ${FG}${app_count}${RESET}"
    box_line

    cat > "$backup_path/RESTORE.sh" << 'RESTORE'
#!/bin/bash
echo "=== ROOT KIT PRO - RESTORE ==="
echo "This will restore apps and data from backup"
read -p "Continue? (y/n): " confirm
