}

# === RISK ANALYSIS ===
risk_analysis() {
    header
    echo -e "  ${YELLOW}${BOLD}RISK ANALYSIS${RESET}  ${DIM}${brand} ${model}${RESET}"
    box_line
    echo ""

    local risks=()
    local score=0

    local battery=$(adb shell dumpsys battery 2>/dev/null | grep "level:" | awk '{print $2}' | tr -d '\r')
    if [ -n "$battery" ]; then
        if [ "$battery" -lt 30 ]; then
            risks+=("  ${RED}BATTERY LOW${RESET} ($battery%) - Minimum 30% required")
            score=$((score + 30))
        elif [ "$battery" -lt 50 ]; then
            risks+=("  ${YELLOW}BATTERY MEDIUM${RESET} ($battery%) - Recommended 50%+")
            score=$((score + 10))
        else
            echo -e "  ${GREEN}Battery: ${battery}%${RESET}"
        fi
    fi

    local oem=$(adb shell settings get global oem_unlock_enabled 2>/dev/null | tr -d '\r')
    if [ "$oem" = "1" ]; then
        echo -e "  ${GREEN}OEM Unlock: enabled${RESET}"
    elif [ "$oem" = "null" ] || [ -z "$oem" ]; then
        risks+=("  ${YELLOW}OEM Unlock: verify in Developer Options${RESET}")
        score=$((score + 5))
    else
        risks+=("  ${RED}OEM Unlock: DISABLED - Enable in Developer Options${RESET}")
        score=$((score + 25))
    fi

    local frp=$(adb shell getprop ro.frp.pst 2>/dev/null | tr -d '\r')
    if [ -n "$frp" ]; then
        risks+=("  ${YELLOW}FRP active${RESET} - Factory reset will be required")
        score=$((score + 15))
    fi

    local bl=$(adb shell getprop ro.boot.flash.locked 2>/dev/null | tr -d '\r')
    if [ "$bl" = "1" ]; then
        risks+=("  ${YELLOW}Bootloader LOCKED${RESET} - Requires Mi Unlock")
        score=$((score + 15))
    else
        echo -e "  ${GREEN}Bootloader: unlocked${RESET}"
    fi

    local dm_verify=$(adb shell getprop ro.boot.verifiedbootstate 2>/dev/null | tr -d '\r')
    if [ "$dm_verify" = "verified" ]; then
        risks+=("  ${YELLOW}DM-Verity active${RESET} - May interfere with root")
        score=$((score + 10))
    fi

    if [ ${#risks[@]} -eq 0 ]; then
        echo -e "  ${GREEN}${BOLD}No risks detected${RESET}"
    else
        for risk in "${risks[@]}"; do
            echo -e "$risk"
        done
    fi

    echo ""
    box_line
    echo -e "  ${DIM}Risk Score: ${RESET}${FG}${score}/100${RESET}"
    if [ $score -lt 25 ]; then
        echo -e "  ${GREEN}${BOLD}LOW RISK${RESET} - Proceed with confidence"
    elif [ $score -lt 50 ]; then
        echo -e "  ${YELLOW}${BOLD}MEDIUM RISK${RESET} - Caution recommended"
    else
        echo -e "  ${RED}${BOLD}HIGH RISK${RESET} - Review before proceeding"
    fi
    box_line
    log "Risk analysis: score=$score brand=$brand model=$model"
}

