    echo -e "  ${BORDER}│${RESET}  ${BORDER}────────────────────────────────────────────────────────────${RESET}"
    echo -e "  ${BORDER}│${RESET}  ${DIM}Select a method number to see instructions or 0 for back${RESET}"
    echo -e "  ${BORDER}└──────────────────────────────────────────────────────────────┘${RESET}"
    echo ""
