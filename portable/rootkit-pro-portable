check_deps() {
    local deps="adb fastboot curl jq"
    local missing=""
    for d in $deps; do
        command -v $d &>/dev/null || missing="$missing $d"
    done
    if [ -n "$missing" ]; then
        echo -e "  ${YELLOW}Installing:${missing}${RESET}"
        echo '2013' | sudo -S pacman -S --needed $missing --noconfirm 2>/dev/null
    fi
}

# === MULTI-DEVICE DETECTION ===
detect_all() {
    DEVICES=()
    local adb_out=$(adb devices 2>/dev/null)
    local lines=$(echo "$adb_out" | grep "device$" | grep -v "List of")
    local count=0

    echo -e "\n  ${DIM}Scanning USB devices...${RESET}"

    if [ -n "$lines" ]; then
        while IFS= read -r line; do
            local s=$(echo "$line" | awk '{print $1}')
            [ -z "$s" ] && continue
            count=$((count + 1))
            local b=$(adb -s "$s" shell getprop ro.product.brand 2>/dev/null | tr -d '\r')
            local m=$(adb -s "$s" shell getprop ro.product.model 2>/dev/null | tr -d '\r')
            local a=$(adb -s "$s" shell getprop ro.build.version.release 2>/dev/null | tr -d '\r')
            local c=$(adb -s "$s" shell getprop ro.product.device 2>/dev/null | tr -d '\r')
            local cpu=$(adb -s "$s" shell getprop ro.product.cpu.abi 2>/dev/null | tr -d '\r')

            local imei=$(adb -s "$s" shell service call iphonesubinfo 1 2>/dev/null | awk -F "'" '{print $2}' | tr -d ' \n.' | head -c 15)
            [ -z "$imei" ] && imei=$(adb -s "$s" shell settings get secure android_id 2>/dev/null | tr -d '\r')

            local rt=$(adb -s "$s" shell "su -c id 2>/dev/null | grep -c uid=0" 2>/dev/null | tr -d '\r')
            [ "$rt" = "1" ] && rt="${GREEN}YES${RESET}" || rt="${RED}NO${RESET}"

            local bl=$(adb -s "$s" shell getprop ro.boot.flash.locked 2>/dev/null | tr -d '\r')
            [ "$bl" = "0" ] && bl="${GREEN}Unlocked${RESET}" || [ "$bl" = "1" ] && bl="${YELLOW}Locked${RESET}" || bl="${DIM}Unknown${RESET}"

            local bat=$(adb -s "$s" shell dumpsys battery 2>/dev/null | grep "level:" | awk '{print $2}' | tr -d '\r')

            DEVICES+=("$s|$b|$m|$c|$a|$cpu|$imei|$bl|$rt|$bat")
        done <<< "$lines"
    fi

    # Check fastboot too
    local fb_out=$(fastboot devices 2>/dev/null)
    if [ -n "$fb_out" ] && echo "$fb_out" | grep -qv "^$"; then
        while IFS= read -r line; do
            local s=$(echo "$line" | awk '{print $1}')
            [ -z "$s" ] && continue
            count=$((count + 1))
            local p=$(fastboot -s "$s" getvar product 2>/dev/null | grep "product:" | awk '{print $2}' | tr -d '\r')
            local bl_info=$(fastboot -s "$s" oem device-info 2>/dev/null)
            local bl_fb="${YELLOW}Locked${RESET}"
            echo "$bl_info" | grep -qi "unlocked.*true" && bl_fb="${GREEN}Unlocked${RESET}"
            DEVICES+=("$s|$p|$p|$p|N/A|N/A|N/A (fastboot)|$bl_fb|N/A|")
        done <<< "$fb_out"
    fi

    if [ $count -eq 0 ]; then
        echo -e "  ${RED}No devices detected${RESET}"
        echo -e "  ${DIM}Connect via USB and enable USB Debugging${RESET}"
        return 1
    fi

    echo -e "  ${GREEN}${count} device(s) detected${RESET}"
    echo ""
    for entry in "${DEVICES[@]}"; do
        IFS='|' read -r s b m c a cpu i bl rt bat <<< "$entry"
        echo -e "  ${BORDER}┌────────────────────────────────────┐${RESET}"
        echo -e "  ${BORDER}│${RESET} ${BLUE}${BOLD}${b} ${m}${RESET}"
        echo -e "  ${BORDER}│${RESET} ${DIM}Serial:${RESET} ${FG}${s}${RESET}"
        echo -e "  ${BORDER}│${RESET} ${DIM}Android:${RESET} ${GREEN}${a}${RESET}  ${DIM}CPU:${RESET} ${FG}${cpu}${RESET}"
        echo -e "  ${BORDER}│${RESET} ${DIM}Bootloader:${RESET} ${bl}  ${DIM}Root:${RESET} ${rt}"
        [ -n "$bat" ] && echo -e "  ${BORDER}│${RESET} ${DIM}Battery:${RESET} ${YELLOW}${bat}%${RESET}"
        echo -e "  ${BORDER}└────────────────────────────────────┘${RESET}"
    done

    # Default to first device for legacy functions
    local first="${DEVICES[0]}"
    IFS='|' read -r serial brand model codename android cpu imei bootloader rooted battery <<< "$first"
    return 0
}

