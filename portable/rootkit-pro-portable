# === DEVICE DETAILS ===
device_details() {
    local pkey=""
    [ -f "$APP_DIR/.premium_key" ] && pkey=$(cat "$APP_DIR/.premium_key" 2>/dev/null) || true
    local prem_status=$(curl -s "http://localhost:20229/api/premium/status?key=$pkey" 2>/dev/null || echo '{"active":false}')
    if ! echo "$prem_status" | grep -q '"active": true'; then
        echo -e "  ${YELLOW}🔒 Premium required for Device Details${RESET}"
        echo -e "  ${DIM}Press P for Premium menu${RESET}"
        return
    fi

    local serial="${DEVICES[0]%%|*}"
    header
    echo -e "  ${BLUE}${BOLD}📊 DEVICE DETAILS${RESET}"
    box_line
    echo ""
    local r=$(curl -s "http://localhost:20229/api/device-details?serial=${serial}" 2>/dev/null || echo '{}')
    if [ -z "$r" ] || [ "$r" = "{}" ]; then
        echo -e "  ${RED}Failed to get device details${RESET}"
        return
    fi
    # RAM
    local ram=$(echo "$r" | python3 -c "import sys,json; d=json.load(sys.stdin); print(f\"{d.get('ram_total_gb','?')}GB ({d.get('ram_avail_gb','?')}GB free)\")" 2>/dev/null)
    [ -n "$ram" ] && echo -e "  ${CYAN}RAM:${RESET}     $ram"
    # Storage
    local st=$(echo "$r" | python3 -c "import sys,json; d=json.load(sys.stdin); print(f\"{d.get('storage_used','?')}/{d.get('storage_total','?')} ({d.get('storage_avail_gb','?')}GB free)\")" 2>/dev/null)
    [ -n "$st" ] && echo -e "  ${GREEN}Storage:${RESET}  $st"
    # Battery
    local bt=$(echo "$r" | python3 -c "import sys,json; d=json.load(sys.stdin); print(f\"{d.get('battery_temp','?')}°C {d.get('battery_voltage','?')}V\");" 2>/dev/null)
    [ -n "$bt" ] && echo -e "  ${YELLOW}Battery:${RESET}  $bt"
    # CPU
    local cpu=$(echo "$r" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('cpu_cores','?'))" 2>/dev/null)
    [ -n "$cpu" ] && echo -e "  ${PURPLE}CPU:${RESET}      ${cpu} cores"
    # Screen
    local scr=$(echo "$r" | python3 -c "import sys,json; d=json.load(sys.stdin); print(f\"{d.get('screen','?')} @ {d.get('screen_density','?')}dpi\")" 2>/dev/null)
    [ -n "$scr" ] && echo -e "  ${FG}Screen:${RESET}    $scr"
    # Security patch
    local sec=$(echo "$r" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('security_patch','?'))" 2>/dev/null)
    [ -n "$sec" ] && echo -e "  ${DIM}Security:${RESET}  $sec"
    # Unlock cooldown
    local unlock_text=$(echo "$r" | python3 -c "
import sys,json
d=json.load(sys.stdin)
u=d.get('unlock',{})
s=u.get('status','')
rt=u.get('remaining_text','')
pct=u.get('progress_pct','')
if s: print(f\"  {s=='unlockable' and '\033[32m' or '\033[33m'}🔓 Unlock: {rt}\")
if pct: print(f\"  \033[90m  {pct}% complete\")
" 2>/dev/null)
    [ -n "$unlock_text" ] && echo -e "$unlock_text"
    box_line
}

