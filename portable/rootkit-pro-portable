# === SHOW METHODS TABLE ===
show_methods() {
    local brand_lower=$(echo "$brand" | tr '[:upper:]' '[:lower:]')
    local methods_str=$(get_unlock_methods)
    local -a methods=($methods_str)

    header
    echo -e "  ${PURPLE}${BOLD}UNLOCK METHODS${RESET}  ${DIM}${brand} ${model}${RESET}"
    box_line
    echo ""
    echo -e "  ${BORDER}│${RESET}  ${DIM}#   Method                          Success   Status${RESET}"
    echo -e "  ${BORDER}│${RESET}  ${BORDER}────────────────────────────────────────────────────────────${RESET}"

    local i=1
    local available=()
    for method_entry in "${methods[@]}"; do
        IFS='|' read -r name url success tool <<< "$method_entry"

        local status_icon=""
        local status_color=""
        if [[ "$url" == http* ]]; then
            status_icon="${YELLOW}Verify${RESET}"
            status_color="$YELLOW"
        else
            status_icon="${GREEN}Available${RESET}"
            status_color="$GREEN"
        fi
        available+=("$method_entry")

        local bar_color="$RED"
        [ "$success" -ge 60 ] && bar_color="$GREEN"
        [ "$success" -ge 35 ] && [ "$success" -lt 60 ] && bar_color="$YELLOW"

        printf "  ${BORDER}│${RESET}  ${DIM}%d${RESET}   ${FG}%-32s${RESET}  ${bar_color}%3d%%${RESET}   %s\n" \
            "$i" "$name" "$success" "$status_icon"
        i=$((i + 1))
