# === USB SYNC ===
sync_usb() {
    header
    echo -e "  ${CYAN}${BOLD}USB SYNC${RESET}"
    box_line
    echo ""

    local usb_mount=""
    for mp in /media/$(whoami)/* /mnt/*; do
        if [ -d "$mp" ] && [ -w "$mp" ]; then
            usb_mount="$mp"
            break
        fi
    done

    if [ -n "$usb_mount" ]; then
        echo -e "  ${GREEN}USB found: ${usb_mount}${RESET}"
        mkdir -p "$usb_mount/rootkit-pro"
        cp "$0" "$usb_mount/rootkit-pro/rootkit-portable.sh"
        chmod +x "$usb_mount/rootkit-pro/rootkit-portable.sh"
        cp -r "$APP_DIR/blocked" "$usb_mount/rootkit-pro/" 2>/dev/null
        echo -e "  ${GREEN}USB synced${RESET}"
    else
        echo -e "  ${YELLOW}No USB with ROOTKIT found${RESET}"
    fi
    box_line
}

# === USB ANALYZER (Secret) ===
usb_analyzer() {
    header
    echo -e "  ${PURPLE}${BOLD}USB ANALYZER${RESET}  ${DIM}All connected USB devices${RESET}"
    box_line
    echo ""
    
    if command -v lsusb &>/dev/null; then
        local count=0
        while IFS= read -r line; do
            [ -z "$line" ] && continue
            count=$((count + 1))
            local parts=()
            for p in $line; do parts+=("$p"); done
            local vid_pid="${parts[5]:-}"
            local desc="${parts[@]:6}"
            local vid="${vid_pid%%:*}"
            local pid="${vid_pid##*:}"
            
            # Determine type icon
            local icon="❓"
            local type_name="other"
            local d="${desc,,}"
            case "$d" in
                *charg*|*power*|*battery*) icon="🔌"; type_name="charger" ;;
                *audio*|*headphone*|*headset*|*speaker*|*microphon*|*sound*) icon="🎧"; type_name="audio" ;;
                *hub*|*root_hub*) icon="🔗"; type_name="hub" ;;
                *keyboard*|*keypad*) icon="⌨️"; type_name="keyboard" ;;
                *mouse*|*pointer*) icon="🖱️"; type_name="mouse" ;;
                *storage*|*flash*|*disk*|*drive*|*mass*) icon="💾"; type_name="storage" ;;
                *camera*|*webcam*|*video*) icon="📷"; type_name="camera" ;;
                *bluetooth*|*bt*) icon="🔵"; type_name="bluetooth" ;;
                *wifi*|*wireless*|*network*|*ether*) icon="🌐"; type_name="network" ;;
                *printer*|*scanner*) icon="🖨️"; type_name="printer" ;;
                *phone*|*android*|*adb*|*fastboot*|*qualcomm*) icon="📱"; type_name="phone" ;;
                *game*|*control*|*joystick*|*xbox*) icon="🎮"; type_name="controller" ;;
                *card*|*reader*) icon="💳"; type_name="card_reader" ;;
                *nvidia*|*display*|*monitor*) icon="🖥️"; type_name="display" ;;
                *) icon="❓"; type_name="other" ;;
            esac
            
            echo -e "  ${icon}  ${BLUE}${type_name}${RESET}  ${FG}${desc:-Unknown}${RESET}  ${DIM}${vid_pid}${RESET}"
            echo -e "      ${DIM}Bus ${parts[1]} Device ${parts[3]%:}${RESET}"
        done < <(lsusb 2>/dev/null)
        
        echo ""
        box_line
        echo -e "  ${GREEN}Total: ${count} USB device(s)${RESET}"
    else
        local sys_count=0
        for d in /sys/bus/usb/devices/*/product; do
            [ -f "$d" ] || continue
            sys_count=$((sys_count + 1))
            local prod=$(cat "$d" 2>/dev/null)
            local mf=$(cat "$(dirname $d)/manufacturer" 2>/dev/null)
            local spd=$(cat "$(dirname $d)/speed" 2>/dev/null)
            echo -e "  ${FG}${mf:-Unknown} ${prod:-Unknown}${RESET}  ${DIM}${spd:+${spd}Mbps}${RESET}"
        done
        box_line
        echo -e "  ${GREEN}Total: ${sys_count} USB device(s)${RESET}"
    fi
    
    box_line
}

